{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "The Settings window: read and change the settings it shows, and open the model manager. Nothing else (SEC-01).",
  "windows": ["settings"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-settings-state",
    "allow-set-appearance",
    "allow-set-hotkey",
    "allow-record-hotkeys",
    "allow-open-model-manager"
  ]
}
